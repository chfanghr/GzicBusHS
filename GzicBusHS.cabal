cabal-version:      2.4
name:               GzicBusHS
version:            0.1.0.0
license:            MIT
copyright:          2022 Connor Fang
maintainer:         chfanghr@gmail.com
author:             Connor Fang
extra-source-files:
  LICENSE
  README.md

common shared
  ghc-options:
    -Wall -Wincomplete-record-updates -Wincomplete-uni-patterns
    -Wmissing-deriving-strategies -Wunused-foralls -Wunused-foralls
    -fprint-explicit-foralls -fprint-explicit-kinds

  mixins:
    base hiding (Prelude),
    relude (Relude as Prelude, Relude.Container.One),
    relude

  default-extensions:
    DataKinds
    DerivingStrategies
    DerivingVia
    DuplicateRecordFields
    LambdaCase
    MultiWayIf
    NoFieldSelectors
    NoStarIsType
    OverloadedLabels
    OverloadedStrings
    StrictData
    TypeFamilies
    ViewPatterns

  build-depends:
    , aeson
    , async
    , base          >=4   && <5
    , data-default
    , directory
    , filepath
    , mtl
    , optics
    , profunctors
    , relude        >=1.0
    , shower
    , with-utf8

  default-language:   GHC2021

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules: GzicBusHS.AuthSession
  build-depends:
    , base16
    , crypton
    , extra
    , http-client
    , http-client-tls
    , http-types
    , network-uri
    , raw-strings-qq
    , regex-tdfa
    , text
    , time

executable GzicBusHS
  import:         shared
  main-is:        Main.hs
  hs-source-dirs: bin
